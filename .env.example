# GitHub MCP Server authentication.
# Create a classic PAT (or fine-grained token) with repo:read scope at:
# https://github.com/settings/tokens
# The token is NEVER logged, printed, or included in any response body.
GITHUB_TOKEN=

# IBM Bob Production API key (Inference type).
# Create at https://bob.ibm.com → subscription instance → API keys → Inference.
# Used directly as a Bearer token — no IBM Cloud IAM exchange required.
# When set, BOB_API_KEY takes priority over WATSONX_API_KEY for inference.
BOB_API_KEY=

# Optional IBM watsonx.ai live explanation integration (IBM Cloud API key path).
# Required only when NOT using BOB_API_KEY.
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
